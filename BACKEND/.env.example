# ─── Database ─────────────────────────────────────────────────────────────────
# REQUIRED: PostgreSQL connection string
# Used in: BACKEND/prisma/schema.prisma
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── Server ───────────────────────────────────────────────────────────────────
# OPTIONAL: Port for the Express server to listen on. Defaults to 3000.
# Used in: BACKEND/server.js
PORT=3000

# ─── JWT Authentication ───────────────────────────────────────────────────────
# REQUIRED: Secret key used to sign and verify JSON Web Tokens
# Used in: BACKEND/src/controllers/auth.controller.js, BACKEND/src/middlewares/auth.middleware.js
JWT_SECRET="your_super_secret_jwt_key_here"

# OPTIONAL: Token expiration time. Defaults to '8h'
# Used in: BACKEND/src/controllers/auth.controller.js
JWT_EXPIRES_IN="8h"

# ─── Web Push / VAPID Keys ────────────────────────────────────────────────────
# REQUIRED for Push Notifications (Service Worker)
# Generate via: npx web-push generate-vapid-keys
# Used in: BACKEND/src/controllers/push.controller.js
VAPID_EMAIL="mailto:admin@yourdomain.com"
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"

# ─── n8n Webhooks (Backend → n8n) ─────────────────────────────────────────────
# REQUIRED for Loyalty PassKit integration
# Used in: BACKEND/src/controllers/loyalty.controller.js, auth.controller.js, order.controller.js
N8N_CREATE_CARD_WEBHOOK="https://n8n.yourdomain.com/webhook/passkit-card-create"
N8N_AWARD_POINTS_WEBHOOK="https://n8n.yourdomain.com/webhook/points-award"
N8N_DEDUCT_POINTS_WEBHOOK="https://n8n.yourdomain.com/webhook/redeem-point"
N8N_DELETE_CARD_WEBHOOK="https://n8n.yourdomain.com/webhook/card-delete"
N8N_ADJUST_POINTS_WEBHOOK="https://n8n.yourdomain.com/webhook/points-adjust"

# ─── Internal Secrets ─────────────────────────────────────────────────────────
# REQUIRED: Shared secrets to authenticate webhook callbacks from n8n to backend.
# MUST be non-empty: when unset the internal endpoints refuse every request (503).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used in: BACKEND/src/middlewares/internal.middleware.js, BACKEND/src/controllers/loyalty.controller.js
N8N_INTERNAL_SECRET="your_shared_internal_secret"
BACKEND_INTERNAL_SECRET="your_shared_internal_secret"

# ─── Cloudinary (image hosting) ───────────────────────────────────────────────
# REQUIRED: used for all product/category/offer/storefront image uploads
# Used in: BACKEND/src/utils/cloudinary.js, BACKEND/src/utils/cloudinaryStorage.js
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
