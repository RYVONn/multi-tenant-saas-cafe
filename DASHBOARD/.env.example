# Base URL of the BACKEND API, including the /api prefix (see BACKEND/src/app.js
# route mounting). The dashboard's api client (src/lib/api-client.ts) reads this
# via import.meta.env.VITE_API_URL.
#
# Local dev (BACKEND running on its default port 3000):
VITE_API_URL=http://localhost:3000/api

# Production (Vercel): set this in the Vercel project's Environment Variables
# to the deployed BACKEND's public URL + /api, e.g.:
# VITE_API_URL=https://api.bleuscoffee.com/api
